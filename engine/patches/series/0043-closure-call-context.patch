+and bind_direct_lambda env lambda_name lambda_cfg call =
+  let lang = env.taint_inst.lang in
+  let snapshots =
+    call.Taint_lambda_call.bindings
+    |> List.map (fun binding ->
+         let taints, shape, _ = check_tainted_expr env binding.Taint_lambda_call.actual in
+         (binding, taints, shape))
+  in
+  let write env name source offset taints shape =
+    let target = LV.lval_of_var name in
+    let writing, aliases = Lval_env.prepare_assignment ~source_suffix:offset lang env target source in
+    Lval_env.finish_assignment
+      (Lval_env.add_lval_shape lang target taints shape (Lval_env.clean lang writing target)) aliases
+    |> Lval_env.clear_call_value name
+  in
+  let rebind_guard guard =
+    let guard = Sig_inst.instantiate_call_guard ~lang
+      ~outer_params:env.func.il_params ~params:lambda_cfg.IL.params ~args:call.args guard in
+    Option.bind guard env.rebind_guard
+  in
+  let needed_vars = IL.NameSet.union env.needed_vars (Lval_env.names env.lval_env) in
+  let initial = Lval_env.clear_active_guards env.lval_env in
+  let initial =
+    List.fold_left (fun current (binding, _, _) ->
+      let parameter = binding.Taint_lambda_call.parameter in
+      let names =
+        Option.to_list (Taint_lambda_call.name parameter)
+        @ (match parameter with ParamPattern (_, pattern) ->
+            List.map fst (pattern_leaves_with_offsets ~lang pattern) | _ -> [])
+      in
+      List.fold_left (fun current name -> write current name None [] Taints.empty S.Bot) current names)
+      initial snapshots
+  in
+  List.fold_left (fun (effects, current) (binding, taints, shape) ->
+    match Taint_lambda_call.name binding.Taint_lambda_call.parameter with
+    | None -> (effects, current)
+    | Some name ->
+        let source = match binding.actual.e with Fetch value -> Some value | _ -> None in
+        let current = write current name source [] taints shape in
+        let current = Lval_env.bind_call_value lang ~before:env.lval_env name binding.actual current in
+        let current = match binding.actual.e with
+          | Composite ((CArray | CList | CTuple), (_, values, _)) ->
+              Lval_env.set_sequence_length name (List.length values) current
+          | _ -> current in
+        let defaults = Taint_lambda_call.default_statements lang binding.parameter binding.actual in
+        let default_effects, current =
+          if List.is_empty defaults then (Effects.empty, current)
+          else
+            let cfg, lambdas = CFG_build.cfg_of_stmts defaults in
+            let body = IL.{ params = lambda_cfg.params; cfg; lambdas } in
+            let effects, mapping = fixpoint_aux env.taint_inst env.func ~needed_vars
+              ~rebind_guard ~enter_lval_env:current ~in_lambda:(Some lambda_name)
+              ?signature_db:env.signature_db ?builtin_signature_db:env.builtin_signature_db
+              ?call_graph:env.call_graph body in
+            (effects, mapping.(cfg.exit).Dataflow_core.out_env)
+        in
+        let taints, shape, current = check_tainted_var { env with lval_env = current } name in
+        let current = Lval_env.add_lval_shape lang (LV.lval_of_var name) taints shape current in
+        let current = match binding.parameter with
+          | ParamPattern (_, pattern) ->
+              pattern_leaves_with_offsets ~lang pattern
+              |> List.fold_left (fun current (leaf, offset) ->
+                   let projected = Shape.find_in_shape_poly ~taints offset shape
+                     |> Option.value ~default:(Taints.empty, S.Bot) in
+                   let current = write current leaf source offset (fst projected) (snd projected) in
+                   let taints, shape, current = check_tainted_var { env with lval_env = current } leaf in
+                   Lval_env.add_lval_shape lang (LV.lval_of_var leaf) taints shape current)
+                 current
+          | _ -> current in
+        (Effects.union effects default_effects, current))
+    (Effects.empty, initial) snapshots
