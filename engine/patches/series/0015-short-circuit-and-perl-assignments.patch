-  (ss0 @ acc_ss, mk_e (Operator ((op, tok), arg0' :: args')) eorig)
+  let result = fresh_lval tok in
+  let constants = Eval_il_partial.mk_env env.lang Dataflow_var_env.VarMap.empty in
+  let rec evaluate arg rest =
+    let statements, value = argument env arg in
+    let value = IL_helpers.exp_of_arg value in
+    let initial = Eval_il_partial.eval constants value in
+    let store = mk_s (Instr (mk_i (Assign (result, value)) eorig)) in
+    match rest with
+    | [] -> (statements @ [store], initial)
+    | next :: remaining ->
+        let condition =
+          match op with
+          | G.And -> value
+          | G.Or -> mk_e (Operator ((G.Not, tok), [Unnamed value])) eorig
+          | _ -> impossible (G.E (G.IdSpecial (G.Op op, tok) |> G.e))
+        in
+        let branch, selected = evaluate next remaining in
+        let constant =
+          match Eval_il_partial.eval_bool constants condition with
+          | Some true -> selected
+          | Some false -> initial
+          | None -> Eval_il_partial.union initial selected
+        in
+        (statements @ [store; mk_s (If (tok, condition, branch, []))], constant)
+  in
+  let statements, constant = evaluate arg0 args in
+  (match result.base, constant with
+   | Var name, G.Lit _ -> name.id_info.id_svalue := Some constant
+   | _ -> ());
+  let value = mk_e (Fetch result) eorig in
+  let value =
+    match env.lang with
+    | Lang.Python | Lang.Js | Lang.Ts | Lang.Perl
+    | Lang.Ruby | Lang.Crystal | Lang.Lua | Lang.Julia
+    | Lang.Lisp | Lang.Scheme | Lang.Clojure | Lang.Elixir -> value
+    | _ ->
+        let negated = mk_e (Operator ((G.Not, tok), [Unnamed value])) eorig in
+        mk_e (Operator ((G.Not, tok), [Unnamed negated])) eorig
+  in
+  (statements, value)
 
