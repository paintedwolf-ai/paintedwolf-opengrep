+      | S.Array value -> S.Array {value with fields = Shape_and_sig.Fields.map cell value.fields}
+      | S.TemplateArray value -> S.TemplateArray {value with fields = Shape_and_sig.Fields.map cell value.fields}
+      | S.Instance (name, fields) -> S.Instance (name, Shape_and_sig.Fields.map cell fields)
+      | S.Exceptions alternatives -> S.Exceptions (List.map (fun (name, value) -> (name, cell value)) alternatives)
