+            let is_allocation = match List.rev context.S.activation, location with
+              | last :: _, Some location -> Tok.equal_location last location
+              | _ -> false in
+            if not is_allocation then context else
+              let context = {context with shared = context.shared || Lazy.force shared} in
+              let updated, limited = Lval_env.register_closure context !current in
+              current := updated;
