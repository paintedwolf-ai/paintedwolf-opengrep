+let cyclic_allocation env flow index =
+  match Hashtbl.find_opt env.cyclic_allocations index with
+  | Some answer -> answer
+  | None ->
+      let visited = Hashtbl.create 16 in
+      let rec search = function
+        | [] -> false
+        | (next, _) :: _ when Int.equal next index -> true
+        | (next, _) :: rest when Hashtbl.mem visited next -> search rest
+        | (next, _) :: rest ->
+            Hashtbl.add visited next ();
+            search (CFG.successors flow next @ rest) in
+      let answer = search (CFG.successors flow index) in
+      Hashtbl.add env.cyclic_allocations index answer;
+      answer
