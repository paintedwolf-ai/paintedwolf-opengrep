diff --git a/src/analyzing/Eval_il_partial.ml b/src/analyzing/Eval_il_partial.ml
--- a/src/analyzing/Eval_il_partial.ml
+++ b/src/analyzing/Eval_il_partial.ml
@@ -397,6 +397,23 @@
    * itself on the rare shared-DAG cond. *)
   eval_memo (IL_helpers.PhysExpTbl.create 8) env exp
 
+let bool_of_svalue env = function
+  | G.Lit (G.Bool (value, _)) -> Some value
+  | G.Lit (G.Int (Some value, _)) when Lang.equal env.lang Lang.Perl ->
+      Some (not (Int64.equal value 0L))
+  | G.Lit (G.Float (Some value, _)) when Lang.equal env.lang Lang.Perl ->
+      Some (not (Float.equal value 0.))
+  | G.Lit (G.String (_, (value, _), _)) when Lang.equal env.lang Lang.Perl ->
+      Some (value <> "" && value <> "0")
+  | G.Lit (G.Null _) when Lang.equal env.lang Lang.Perl -> Some false
+  | _ -> None
+
+let rec eval_bool env (exp : IL.exp) =
+  match exp.e with
+  | IL.Operator ((G.Not, _), [IL.Unnamed value]) ->
+      Option.map not (eval_bool env value)
+  | _ -> bool_of_svalue env (eval env exp)
+
 let eval_concat (env : env) args =
   match List_.map (eval env) args with
   | [] -> G.Lit (literal_of_string "")
