+let unconditional_input_sanitizer (taint_inst : Taint_rule_inst.t) id sources =
+  taint_inst.preds.is_sanitizer (G.Tk (snd id))
+  |> List.exists (fun (matched : Rule.taint_sanitizer Taint_spec_match.t) ->
+         let spec = matched.spec in
+         spec.sanitizer_exact && Taint_spec_match.is_exact matched
+         && not spec.sanitizer_by_side_effect
+         && Option.is_none spec.sanitizer_output_type
+         && Option.is_none spec.sanitizer_requires_type
+         && Option.is_none spec.sanitizer_requires_model_type
+         && (not spec.not_conflicting || List.is_empty sources))
+
