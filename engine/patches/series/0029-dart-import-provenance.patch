+let predeclare_dart_globals env program =
+  List.iter
+    (fun statement ->
+      match statement.s with
+      | DefStmt ({ name = EN (Id (id, info)); _ }, _)
+      | DefStmt ({ name = EPattern (PatId (id, info)); _ }, _) ->
+          declare_var env Lang.Dart id info ~force_global:true ~explicit:true None None
+      | _ -> ())
+    program
