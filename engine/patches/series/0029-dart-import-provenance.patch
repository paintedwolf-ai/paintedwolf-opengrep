+let rec constructor_type_name typ =
+  match typ.t with
+  | TyN name -> Some name
+  | TyApply (base, arguments) ->
+      Option.map (fun name -> H2.add_type_args_to_name name arguments)
+        (constructor_type_name base)
+  | _ -> None
+
+let constructor_expression tok typ member arguments =
+  match member with
+  | None -> New (tok, typ, empty_id_info (), arguments) |> G.e
+  | Some (dot, id) ->
+      let receiver =
+        match constructor_type_name typ with
+        | Some name -> N name |> G.e
+        | None -> OtherExpr (("constructor_type", tok), [ G.T typ ]) |> G.e
+      in
+      let callee = DotAccess (receiver, dot, FN (Id (id, empty_id_info ()))) |> G.e in
+      Call (callee, arguments) |> G.e
 
