+let join_return_shape left right =
+  match (left, right) with
+  | None, shape | shape, None -> shape
+  | Some left, Some right ->
+      let (S.Cell (_, shape)) =
+        Shape.join_cell (S.Cell (`None, left)) (S.Cell (`None, right))
+      in
+      Some shape
+
+let contextual_return_shape env (body : F.fun_cfg) mapping =
+  let flow = body.cfg in
+  let live index =
+    CFG.NodeiSet.mem index flow.reachable
+    && not (Lval_env.is_dead mapping.(index).D.out_env)
+  in
+  let shapes =
+    flow.graph#nodes#tolist
+    |> List.fold_left
+         (fun shapes (index, node) ->
+           match node.F.n with
+           | NReturn _ when live index ->
+               let shape =
+                 Hashtbl.find_opt env.return_values index
+                 |> Option.value ~default:S.Bot
+               in
+               join_return_shape shapes (Some shape)
+           | _ -> shapes)
+         None
+  in
+  let visited = ref CFG.NodeiSet.empty in
+  let rec fallthrough index =
+    if CFG.NodeiSet.mem index !visited || not (live index) then false
+    else (
+      visited := CFG.NodeiSet.add index !visited;
+      match (flow.graph#nodes#find index).F.n with
+      | NReturn _ | NThrow _ -> false
+      | Exit | NOther (Noop _) | NGoto _ | Join ->
+          CFG.predecessors flow index
+          |> List.exists (fun (index, _) -> fallthrough index)
+      | _ -> true)
+  in
+  if fallthrough flow.exit then join_return_shape shapes (Some S.Bot)
+  else shapes
+
