+(* Prefix effects cover the postfix chain until an explicit parenthesized boundary. *)
+let rec postfix_prefix_count (expression : CST.expression) =
+  match expression with
+  | `Choice_simple_id (`Prim_exp primary) -> (
+      match primary with
+      | `Await_exp (_, operand) ->
+          1 + (match operand with
+              | `Exp expression -> postfix_prefix_count expression
+              | `Call_exp (callee, _) -> postfix_prefix_count callee
+              | `Tern_exp _ -> 0)
+      | `Try_exp (_, operand) ->
+          1 + (match operand with
+              | `Exp expression -> postfix_prefix_count expression
+              | `Call_exp (callee, _) -> postfix_prefix_count callee
+              | `Bin_exp _ | `Tern_exp _ -> 0)
+      | _ -> 0)
+  | `Choice_simple_id (`Un_exp (`Call_exp (callee, _))) ->
+      postfix_prefix_count callee
+  | `Choice_simple_id (`Un_exp (`Navi_exp (`Exp receiver, _))) ->
+      postfix_prefix_count receiver
+  | _ -> 0
+
+let rec apply_postfix count (head : G.expr) suffix =
+  if count = 0 then suffix head
+  else
+    match head.G.e with
+    | G.Await (token, expression) ->
+        G.Await (token, apply_postfix (count - 1) expression suffix) |> G.e
+    | G.OtherExpr (("Try", token), [ G.E expression ]) ->
+        G.OtherExpr
+          (("Try", token), [ G.E (apply_postfix (count - 1) expression suffix) ])
+        |> G.e
+    | _ -> suffix head
+
