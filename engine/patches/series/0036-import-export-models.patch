+let translate_import_model model =
+  let names values = `A (List_.map (fun name -> `String name) values) in
+  let export fact =
+    let identity = [("module", `String fact.export_module); ("symbol", `String fact.export_name)] in
+    let target = match fact.export_origin with
+      | None -> [("absent", `Bool true)]
+      | Some (module_name, symbol) -> [("origin", `O [
+          ("module", `String module_name); ("symbol", names symbol)])]
+    in
+    `O (identity @ target)
+  in
+  let implicit = if List.is_empty model.implicit_modules then []
+    else [("implicit", names model.implicit_modules)] in
+  let exports = if List.is_empty model.export_facts then []
+    else [("exports", `A (List_.map export model.export_facts))] in
+  `O (implicit @ exports)
+
