+let rec translate_precondition = function
+  | PLabel label -> label
+  | PBool true | PAnd [] -> "True"
+  | PBool false | POr [] -> "False"
+  | PAnd values -> "(" ^ String.concat " and " (List.map translate_precondition values) ^ ")"
+  | POr values -> "(" ^ String.concat " or " (List.map translate_precondition values) ^ ")"
+  | PNot value -> "(not " ^ translate_precondition value ^ ")"
+  | PVariable _ -> invalid_arg "Inferred taint variables cannot be translated as rule labels"
 
