    "build"
    "--dev-pkg"
    "%{dev}%"
    "--with-uunf"
    "%{uunf:installed}%"
    "--with-cmdliner"
    "%{cmdliner:installed}%"
  ]
  post-messages:
    "If the build fails with \"ocamlopt.opt got signal and exited\", issue 'ulimit -s unlimited' and retry."
      {failure & (arch = "ppc64" | arch = "arm64")}
  dev-repo: "git+https://erratique.ch/repos/uucp.git"
