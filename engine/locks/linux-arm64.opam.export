  tags: ["org:mirage" "org:ocamllabs"]
  homepage: "https://github.com/avsm/ocaml-yaml"
  doc: "https://avsm.github.io/ocaml-yaml/"
  bug-reports: "https://github.com/avsm/ocaml-yaml/issues"
  depends: [
    "ocaml" {>= "4.13.0"}
    "dune" {>= "2.0"}
    "dune-configurator"
    "ctypes" {>= "0.14.0"}
    "bos"
