    "crowbar" {with-test}
    "junit_alcotest" {>= "2.0.2" & with-test}
    "ezjsonm" {with-test}
  ]
  conflicts: [
    "result" {< "1.5"}
  ]
  build: [
    ["dune" "subst"] {dev}
    ["dune" "build" "-p" name "-j" jobs]
    ["dune" "runtest" "-p" name "-j" jobs] {with-test}
  ]
  dev-repo: "git+https://github.com/avsm/ocaml-yaml.git"
