    ["dune" "build" "-p" name "-j" jobs]
    ["dune" "runtest" "-p" name "-j" jobs] {with-test}
  ]
  dev-repo: "git+https://github.com/inhabitedtype/faraday.git"
  url {
    src: "https://github.com/inhabitedtype/faraday/archive/0.8.2.tar.gz"
