    "fmt" {with-test}
    "fpath" {with-test}
    "rresult" {with-test}
    "ocamlfind" {with-test}
  ]
  conflicts: [
    "mirage-xen" {< "6.0.0"}
    "ocaml-freestanding"
  ]
  build: [
    ["dune" "build" "-p" name "-j" jobs]
    ["dune" "runtest" "-p" name "-j" jobs] {with-test}
  ]
  install: [
    ["dune" "install" "-p" name] {with-test}
    ["ocaml" "./test/test_runes.ml"] {with-test}
  ]
  dev-repo: "git+https://github.com/mirage/checkseum.git"
