    "astring"
    "fpath"
    "fmt" {>= "0.8.10"}
    "logs"
    "mtime" {with-test}
  ]
  build: ["ocaml" "pkg/pkg.ml" "build" "--dev-pkg" "%{dev}%"]
  dev-repo: "git+https://erratique.ch/repos/bos.git"
  url {
